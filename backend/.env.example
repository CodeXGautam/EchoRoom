# Copy to .env for local development. Never commit .env.

APP_ENV=development

# --- Auth ---
# Local dev without a Supabase project: accept "dev:<id>" tokens (NO verification).
AUTH_DEV_MODE=true
# With Supabase: set AUTH_DEV_MODE=false and the project URL.
# SUPABASE_URL=https://<project-ref>.supabase.co
# Only for projects still on the legacy HS256 secret (Dashboard → JWT keys):
# SUPABASE_JWT_SECRET=

# Comma-separated full origins allowed for CORS and WebSocket upgrades.
ALLOWED_ORIGINS=http://localhost:3000

# --- Postgres ---
# Local docker-compose:
DATABASE_URL=postgres://echoroom:echoroom@localhost:5432/echoroom?sslmode=disable
# Supabase (Dashboard → Connect → Session pooler, IPv4-reachable from Render):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# If you use the transaction pooler (port 6543) instead, append
#   &default_query_exec_mode=simple_protocol
# because that pooler does not support pgx's prepared statements.

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- HTTP ---
# Render injects PORT automatically; HTTP_PORT is the local fallback.
HTTP_PORT=8080
