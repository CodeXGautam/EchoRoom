# Copy to .env.local. NEXT_PUBLIC_* values are baked into the browser bundle,
# so never put secrets here (the Supabase publishable/anon key is public by design).

# Go API base URL (Render URL in production). The WebSocket URL is derived from it.
NEXT_PUBLIC_API_URL=http://localhost:8080

# "dev"      → no Supabase needed; each browser tab is a random guest (backend AUTH_DEV_MODE=true)
# "supabase" → real Supabase anonymous sign-in
NEXT_PUBLIC_AUTH_MODE=dev

# Required when NEXT_PUBLIC_AUTH_MODE=supabase (Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only if Supabase CAPTCHA protection is ON with provider "Turnstile".
# Cloudflare dashboard → Turnstile → add widget → Site Key (public).
# The matching Secret Key goes into Supabase, never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
